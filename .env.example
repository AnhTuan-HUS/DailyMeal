# -------------------------------------------------------------
# DailyMeal Environment Configuration
# -------------------------------------------------------------

# Environment: development / staging / production
ENVIRONMENT=development
PROJECT_NAME="DailyMeal API"
DEBUG=true

# Database (PostgreSQL - Local Host Port: 15432)
POSTGRES_SERVER=localhost
POSTGRES_PORT=15432
POSTGRES_USER=dailymeal_user
POSTGRES_PASSWORD=dailymeal_secret_password
POSTGRES_DB=dailymeal_db

# FastAPI Backend (Local Host Port: 18000)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=18000
SECRET_KEY=change_this_to_a_super_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI / LLM Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend (Local Host Port: 13000)
FRONTEND_PORT=13000
VITE_API_BASE_URL=http://localhost:18000/api/v1
